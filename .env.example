# Optional. Only needed for authenticated Binance endpoints (live trading).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Binance Spot Testnet keys for testnet instances (create them at https://testnet.binance.vision)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Optional Telegram notifications: create a bot with @BotFather, send it a message,
# then run `python -m kripto_bot telegram-setup` to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
